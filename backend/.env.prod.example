SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://<prod-db-host>:5432/<prod-db-name>?sslmode=require
SPRING_DATASOURCE_USERNAME=<prod-db-user>
SPRING_DATASOURCE_PASSWORD=<prod-db-password>

APP_JWT_SECRET=<prod-jwt-secret-min-32-bytes>
APP_PAYMENT_PROVIDER=razorpay
APP_PAYMENT_RAZORPAY_KEY_ID=<prod-razorpay-key-id>
APP_PAYMENT_RAZORPAY_KEY_SECRET=<prod-razorpay-key-secret>
APP_PAYMENT_WEBHOOK_SECRET=<prod-payment-webhook-secret>
APP_CORS_ALLOWED_ORIGINS=https://app.example.com

WHATSAPP_ENABLED=true
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_WHATSAPP_FROM=whatsapp:+<twilio-business-number>
TWILIO_WHATSAPP_TEMPLATE_OTP_SID=<twilio-content-template-otp-sid>
TWILIO_WHATSAPP_TEMPLATE_DELIVERY_OTP_SID=<twilio-content-template-delivery-otp-sid>
TWILIO_WHATSAPP_TEMPLATE_DELIVERY_ASSIGNMENT_SID=<twilio-content-template-delivery-assignment-sid>
TWILIO_WHATSAPP_TEMPLATE_LOW_STOCK_SID=<twilio-content-template-low-stock-sid>
TWILIO_WHATSAPP_TEMPLATE_PLACED_SID=<twilio-content-template-placed-sid>
TWILIO_WHATSAPP_TEMPLATE_CONFIRMED_SID=
TWILIO_WHATSAPP_TEMPLATE_PROCESSING_SID=
TWILIO_WHATSAPP_TEMPLATE_SHIPPED_SID=
TWILIO_WHATSAPP_TEMPLATE_DELIVERED_SID=
TWILIO_WHATSAPP_TEMPLATE_CANCELLED_SID=
TWILIO_WHATSAPP_TEMPLATE_REFUNDED_SID=
ADMIN_WHATSAPP_NUMBER=+91XXXXXXXXXX

# Optional: override storage paths to match container mounts.
CARNALYSYS_STORAGE_AVATAR_DIR=/app/storage/uploads/avatars
CARNALYSYS_STORAGE_VEHICLES_DIR=/app/storage/uploads/vehicles
CARNALYSYS_STORAGE_RECEIPTS_DIR=/app/storage/uploads/receipts
CARNALYSYS_STORAGE_LOGS_DIR=/app/storage/logs
