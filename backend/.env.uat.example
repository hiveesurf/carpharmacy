SPRING_PROFILES_ACTIVE=uat
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://<uat-db-host>:5432/<uat-db-name>
SPRING_DATASOURCE_USERNAME=<uat-db-user>
SPRING_DATASOURCE_PASSWORD=<uat-db-password>

APP_JWT_SECRET=<uat-jwt-secret-min-32-bytes>
APP_PAYMENT_PROVIDER=razorpay
APP_PAYMENT_RAZORPAY_KEY_ID=<uat-razorpay-key-id>
APP_PAYMENT_RAZORPAY_KEY_SECRET=<uat-razorpay-key-secret>
APP_PAYMENT_WEBHOOK_SECRET=<uat-payment-webhook-secret>
APP_CORS_ALLOWED_ORIGINS=https://uat.example.com

WHATSAPP_ENABLED=true
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_WHATSAPP_FROM=whatsapp:+<twilio-sandbox-or-business-number>
TWILIO_WHATSAPP_TEMPLATE_OTP_SID=<twilio-content-template-otp-sid>
TWILIO_WHATSAPP_TEMPLATE_DELIVERY_OTP_SID=<twilio-content-template-delivery-otp-sid>
TWILIO_WHATSAPP_TEMPLATE_DELIVERY_ASSIGNMENT_SID=<twilio-content-template-delivery-assignment-sid>
TWILIO_WHATSAPP_TEMPLATE_LOW_STOCK_SID=<twilio-content-template-low-stock-sid>
TWILIO_WHATSAPP_TEMPLATE_PLACED_SID=<twilio-content-template-placed-sid>
TWILIO_WHATSAPP_TEMPLATE_CONFIRMED_SID=
TWILIO_WHATSAPP_TEMPLATE_PROCESSING_SID=
TWILIO_WHATSAPP_TEMPLATE_SHIPPED_SID=
TWILIO_WHATSAPP_TEMPLATE_DELIVERED_SID=
TWILIO_WHATSAPP_TEMPLATE_CANCELLED_SID=
TWILIO_WHATSAPP_TEMPLATE_REFUNDED_SID=
ADMIN_WHATSAPP_NUMBER=+91XXXXXXXXXX